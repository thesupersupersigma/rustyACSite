---
// Not linked from anywhere, noindex, not in the sitemap (astro.config.mjs). One line and a way home.
import Base from '../layouts/Base.astro';
---

<Base title="What next" description="Vanilla first." noindex bare>
  <section class="next">
    <p class="next__line">Vanilla first. After that, things might get weird.</p>
    <a class="next__home" href="/">back home</a>
  </section>
</Base>

<style>
  .next {
    display: grid;
    place-content: center;
    justify-items: start;
    gap: 28px;
    min-height: 100vh;
    min-height: 100svh;
    padding: 48px var(--gutter);
    /* dark in both themes */
    background: #0e0e0e;
    color: #f5f5f5;
    font-family: var(--font-mono);
  }

  .next__line {
    font-size: clamp(1rem, 0.8rem + 1vw, 1.375rem);
    max-width: 30ch;
  }

  .next__line::after {
    content: '_';
    color: #d2581f;
    animation: blink 1.2s steps(1) infinite;
  }

  .next__home {
    font-size: var(--step--1);
    color: #9a9a9a;
  }

  .next__home:hover {
    color: #f5f5f5;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .next__line::after {
      animation: none;
    }
  }
</style>
