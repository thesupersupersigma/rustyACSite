---
import Page from '../../layouts/Page.astro';
import { getPublishedPosts, postDate, readingMinutes } from '../../lib/devlog';
import { LINKS } from '../../lib/site';

const posts = await getPublishedPosts();

const description = 'The rustyAC devlog: longer write-ups of how Assetto Corsa is being rebuilt in Rust and what turned up on the way.';
---

<Page title="Devlog" intro="Longer write-ups: how a part was ported, what went wrong, what turned up on the way." description={description}>
  {
    posts.length === 0 ? (
      <div class="empty card">
        <p class="empty__title">The first posts are being written.</p>
        <p class="muted">
          Until they are out, the technical reports are the place to read: <a href={LINKS.docs} rel="noopener">every
          port report on GitHub</a>.
        </p>
      </div>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <li class="post">
            <p class="post__meta mono muted">
              <time datetime={post.data.date.toISOString().slice(0, 10)}>{postDate(post.data.date)}</time> ·{' '}
              {readingMinutes(post.body ?? '')} min read
            </p>
            <h2 class="post__title">
              <a href={`/devlog/${post.id}`}>{post.data.title}</a>
            </h2>
            <p class="muted">{post.data.summary}</p>
          </li>
        ))}
      </ul>
    )
  }
  <p class="feed">
    <a href="/devlog/rss.xml">RSS feed</a>
  </p>
</Page>

<style>
  .empty {
    display: grid;
    gap: 6px;
    padding: clamp(20px, 3vw, 28px);
    max-width: 44rem;
  }

  .empty__title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .posts {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }

  .post {
    display: grid;
    gap: 8px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }

  .post:first-child {
    padding-top: 0;
  }

  .post__meta {
    font-size: var(--step--1);
  }

  .post__title {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
  }

  .post__title a {
    text-decoration: none;
  }

  .post__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .feed {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
