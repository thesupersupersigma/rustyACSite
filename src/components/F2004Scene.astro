---
// The pinned F2004 night scene. This file only holds the shell: the gate (no phones, WebGL2 only),
// the scroll progress and the lazy import. three.js and everything else live in src/scene/ and are
// fetched just before the section scrolls into view.
import { SITE_VERSION } from '../lib/site';
---

<script is:inline>
  // Decide before first paint whether this visitor gets the scene, so the page never jumps.
  (function () {
    try {
      if (matchMedia('(pointer: coarse) and (max-width: 900px)').matches) return;
      var gl = document.createElement('canvas').getContext('webgl2');
      if (!gl) return;
      var lose = gl.getExtension('WEBGL_lose_context');
      if (lose) lose.loseContext();
      document.documentElement.dataset.webgl = 'on';
    } catch (e) {}
  })();
</script>

<section class="scene" data-scene data-version={SITE_VERSION} aria-label="The F2004 on a wet track at night">
  <div class="scene__stage">
    <div class="scene__frame" data-scene-frame>
      <canvas class="scene__canvas" data-scene-canvas aria-hidden="true"></canvas>
      <div class="scene__loader" data-scene-loader>
        <div class="scene__bar" role="progressbar" aria-label="Loading the 3D scene" aria-valuemin="0" aria-valuemax="100">
          <span></span>
        </div>
      </div>
      <p class="scene__caption mono">F2004 · night · wet</p>
    </div>
    <div class="scene__fade" aria-hidden="true"></div>
  </div>
</section>

<script>
  import type { F2004Scene } from '../scene/main';

  declare global {
    interface Window {
      /** The scene API, for tasks 02/03 and for debugging in the console. */
      __f2004?: F2004Scene;
    }
  }

  const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
  const smooth = (a: number, b: number, x: number) => {
    const t = clamp01((x - a) / (b - a));
    return t * t * (3 - 2 * t);
  };

  function init(section: HTMLElement) {
    const frame = section.querySelector<HTMLElement>('[data-scene-frame]');
    const canvas = section.querySelector<HTMLCanvasElement>('[data-scene-canvas]');
    const loader = section.querySelector<HTMLElement>('[data-scene-loader]');
    const bar = loader?.querySelector<HTMLElement>('[role="progressbar"]');
    if (!frame || !canvas || !loader || !bar) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let scene: F2004Scene | undefined;
    let p = 0;
    let queued = false;

    // Scroll progress through the section: 0 when its top reaches the top of the screen, 1 when its
    // bottom reaches the bottom. The page scrolls normally; this only reads the position.
    const measure = () => {
      queued = false;
      const rect = section.getBoundingClientRect();
      const span = rect.height - window.innerHeight;
      p = span > 0 ? clamp01(-rect.top / span) : 0;
      section.style.setProperty('--entry', smooth(0, 0.2, p).toFixed(4));
      section.style.setProperty('--exit', smooth(0.8, 1, p).toFixed(4));
      section.style.setProperty('--stage', (smooth(0.16, 0.24, p) * (1 - smooth(0.76, 0.84, p))).toFixed(4));
      scene?.setProgress(p);
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(measure);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    measure();

    const load = async () => {
      try {
        const { createF2004Scene } = await import('../scene/main');
        scene = await createF2004Scene({
          canvas,
          container: frame,
          section,
          assetVersion: section.dataset['version'] ?? '0',
          debug: new URLSearchParams(location.search).get('debug') === '1',
          reducedMotion: reduced.matches,
          onProgress: (fraction) => {
            bar.style.setProperty('--load', fraction.toFixed(3));
            bar.setAttribute('aria-valuenow', String(Math.round(fraction * 100)));
          },
        });
        scene.setProgress(p);
        reduced.addEventListener('change', () => scene?.setReducedMotion(reduced.matches));
        window.__f2004 = scene;
        section.dataset['state'] = 'ready';
        // the bar fades out in CSS; this takes it out of the accessibility tree as well
        loader.setAttribute('aria-hidden', 'true');
      } catch (err) {
        console.error('[f2004] the scene could not start, removing the section', err);
        section.hidden = true;
      }
    };

    // Start loading about a screen and a half before the section arrives.
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        void load();
      },
      { rootMargin: '150% 0px' },
    );
    io.observe(section);
  }

  const section = document.querySelector<HTMLElement>('[data-scene]');
  if (section && document.documentElement.dataset['webgl'] === 'on') init(section);
</script>

<style>
  .scene {
    display: none;
    position: relative;
    height: 300vh;
    --entry: 0;
    --exit: 0;
    --stage: 0;
  }

  :global(html[data-webgl='on']) .scene:not([hidden]) {
    display: block;
  }

  /* Phones never get the section, even if the gate script ran before a resize. */
  @media (pointer: coarse) and (max-width: 900px) {
    :global(html[data-webgl='on']) .scene:not([hidden]) {
      display: none;
    }
  }

  .scene__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  /* Entry: a rounded card inside the page that grows to the full screen. */
  .scene__frame {
    --rest: calc(1 - var(--entry));
    position: absolute;
    inset: 0;
    background: #05070d;
    clip-path: inset(
      calc(var(--rest) * (var(--bar-h) + 9vh)) calc(var(--rest) * 15vw) calc(var(--rest) * 9vh)
        calc(var(--rest) * 15vw) round calc(var(--rest) * var(--radius))
    );
  }

  .scene__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    cursor: grab;
    /* vertical swipes scroll the page; horizontal drags orbit */
    touch-action: pan-y;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }

  .scene__canvas:active {
    cursor: grabbing;
  }

  .scene[data-state='ready'] .scene__canvas {
    opacity: 1;
  }

  .scene__loader {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: opacity 0.4s var(--ease);
  }

  .scene[data-state='ready'] .scene__loader {
    opacity: 0;
    pointer-events: none;
  }

  .scene__bar {
    --load: 0;
    width: min(220px, 40%);
    height: 2px;
    background: rgb(245 245 245 / 0.12);
    border-radius: 2px;
    overflow: hidden;
  }

  .scene__bar span {
    display: block;
    height: 100%;
    background: #d2581f;
    transform-origin: left;
    transform: scaleX(var(--load));
    transition: transform 0.2s linear;
  }

  .scene__caption {
    position: absolute;
    left: var(--gutter);
    bottom: 20px;
    margin: 0;
    color: rgb(245 245 245 / 0.72);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    opacity: var(--stage);
    pointer-events: none;
  }

  /* Exit: the stage fades into the page colour. */
  .scene__fade {
    position: absolute;
    inset: 0;
    background: var(--bg);
    opacity: var(--exit);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .scene__frame {
      clip-path: none;
      opacity: calc(var(--entry) * (1 - var(--exit)));
    }

    .scene__fade {
      display: none;
    }
  }
</style>
