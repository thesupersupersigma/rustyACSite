---
// Before/after slider with one tab per track. The handle is a native range input stretched over
// the picture, so dragging, touch and the arrow keys all work without custom pointer code.
import { Picture } from 'astro:assets';
import spaDebug from '../assets/screenshots/renderer_core_spa_debug.png';
import spa from '../assets/screenshots/renderer_core_spa.png';
import monzaDebug from '../assets/screenshots/renderer_core_monza_debug.png';
import monza from '../assets/screenshots/renderer_core_monza.png';
import lagunaDebug from '../assets/screenshots/renderer_core_laguna_seca_debug.png';
import laguna from '../assets/screenshots/renderer_core_laguna_seca.png';

const PAIRS = [
  { id: 'spa', label: 'Spa', before: spaDebug, after: spa },
  { id: 'monza', label: 'Monza', before: monzaDebug, after: monza },
  { id: 'laguna-seca', label: 'Laguna Seca', before: lagunaDebug, after: laguna },
];

// The sources are 2560x1440. The slider is at most 1120 CSS px wide (the page width), so a 2x screen
// wants 2240 device px: 2560 covers that, and the smaller widths cover phones and 1x screens.
const WIDTHS = [640, 960, 1280, 1920, 2560];
// below the page width the slider fills the window minus the gutters (16, 24 or 32 px a side)
const SIZES =
  '(min-width: 1184px) 1120px, (min-width: 1024px) calc(100vw - 64px), (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)';
---

<div class="cmp" data-compare>
  <div class="cmp__tabs" role="tablist" aria-label="Track">
    {
      PAIRS.map((pair, i) => (
        <button
          type="button"
          role="tab"
          id={`cmp-tab-${pair.id}`}
          aria-controls={`cmp-panel-${pair.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {pair.label}
        </button>
      ))
    }
  </div>

  {
    PAIRS.map((pair, i) => (
      <div
        class="cmp__panel"
        role="tabpanel"
        id={`cmp-panel-${pair.id}`}
        aria-labelledby={`cmp-tab-${pair.id}`}
        hidden={i !== 0}
      >
        <div class="cmp__view card" style="--pos: 50%">
          <Picture
            src={pair.after}
            formats={['avif']}
            fallbackFormat="webp"
            widths={WIDTHS.filter((w) => w <= pair.after.width)}
            sizes={SIZES}
            alt={`${pair.label} in rustyAC, drawn with Assetto Corsa's own shaders`}
            loading="lazy"
            class="cmp__img"
          />
          <div class="cmp__before">
            <Picture
              src={pair.before}
              formats={['avif']}
            fallbackFormat="webp"
              widths={WIDTHS.filter((w) => w <= pair.before.width)}
              sizes={SIZES}
              alt={`${pair.label} in rustyAC's early debug view`}
              loading="lazy"
              class="cmp__img"
            />
          </div>
          <span class="cmp__tag cmp__tag--l mono" aria-hidden="true">debug view</span>
          <span class="cmp__tag cmp__tag--r mono" aria-hidden="true">AC's shaders</span>
          <span class="cmp__handle" aria-hidden="true"><span class="cmp__knob" /></span>
          <input
            class="cmp__range"
            type="range"
            min="0"
            max="100"
            step="0.1"
            value="50"
            aria-label={`${pair.label}: how much of the debug view to show`}
          />
        </div>
      </div>
    ))
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    const select = (index: number, focus: boolean) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = panels[i];
        if (panel) panel.hidden = !on;
      });
      if (focus) tabs[index]?.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (step === 0) return;
        e.preventDefault();
        select((i + step + tabs.length) % tabs.length, true);
      });
    });

    for (const range of root.querySelectorAll<HTMLInputElement>('.cmp__range')) {
      const view = range.closest<HTMLElement>('.cmp__view');
      const update = () => view?.style.setProperty('--pos', `${range.value}%`);
      range.addEventListener('input', update);
      // The fine step keeps dragging smooth; the arrow keys would crawl at 0.1 per press, so they
      // move 2 points instead (Home, End and Page keys keep their native behaviour).
      range.addEventListener('keydown', (e) => {
        const dir =
          e.key === 'ArrowRight' || e.key === 'ArrowUp' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowDown' ? -1 : 0;
        if (dir === 0) return;
        e.preventDefault();
        range.value = String(Math.min(100, Math.max(0, Number(range.value) + dir * 2)));
        update();
      });
      update();
    }
  }
</script>

<style>
  .cmp {
    display: grid;
    gap: 14px;
  }

  .cmp__tabs {
    display: inline-flex;
    justify-self: start;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }

  .cmp__tabs button {
    min-height: 34px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    font-size: 0.875rem;
    cursor: pointer;
  }

  .cmp__tabs button:hover {
    color: var(--text);
  }

  .cmp__tabs button[aria-selected='true'] {
    background: var(--line);
    color: var(--text);
  }

  .cmp__view {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    /* the pictures are always dark game frames, whatever the theme */
    background: #0e0e0e;
    user-select: none;
  }

  .cmp__view :global(.cmp__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cmp__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .cmp__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #f5f5f5;
    pointer-events: none;
  }

  .cmp__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 36px;
    height: 36px;
    margin: -18px 0 0 -18px;
    border-radius: 50%;
    background: #f5f5f5;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.5);
  }

  .cmp__knob::before,
  .cmp__knob::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    border: solid #0e0e0e;
    border-width: 2px 2px 0 0;
  }

  .cmp__knob::before {
    left: 9px;
    transform: translateY(-50%) rotate(-135deg);
  }

  .cmp__knob::after {
    right: 9px;
    transform: translateY(-50%) rotate(45deg);
  }

  .cmp__tag {
    position: absolute;
    bottom: 12px;
    padding: 4px 8px;
    border-radius: 6px;
    background: rgb(14 14 14 / 0.72);
    color: #f5f5f5;
    font-size: 0.75rem;
    pointer-events: none;
  }

  .cmp__tag--l {
    left: 12px;
  }

  .cmp__tag--r {
    right: 12px;
  }

  .cmp__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    /* vertical swipes still scroll the page */
    touch-action: pan-y;
  }

  .cmp__view:has(.cmp__range:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 479.98px) {
    .cmp__tag {
      display: none;
    }
  }
</style>
