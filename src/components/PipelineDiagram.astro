---
// The four steps as one picture: decompile -> map -> port -> prove, with the loop back from a failed
// proof. Drawn in the site's own colours (the CSS variables), so it follows the theme.
const STEPS = [
  { n: '01', title: 'Decompile', lines: ['acs.exe and its debug', 'symbols, in Ghidra'] },
  { n: '02', title: 'Map', lines: ['a written report', 'for each system'] },
  { n: '03', title: 'Port', lines: ['Rust, one to one,', 'from the disassembly'] },
  { n: '04', title: 'Prove', lines: ['the oracle compares', 'every bit'] },
];
const W = 200;
const GAP = 40;
const x = (i: number) => 20 + i * (W + GAP);
---

<figure class="diagram">
  <div class="diagram__scroll" tabindex="0" role="group" aria-label="Diagram: decompile, map, port, prove">
    <svg viewBox="0 0 960 236" role="img" aria-labelledby="pipe-title pipe-desc">
      <title id="pipe-title">The rustyAC pipeline</title>
      <desc id="pipe-desc">
        Four steps in a row. Decompile acs.exe and its debug symbols in Ghidra. Map each system into a written
        report. Port it to Rust, one to one, from the disassembly. Prove it: the oracle compares every bit. When a
        bit differs, the port is fixed and the proof runs again.
      </desc>
      <defs>
        <marker id="pipe-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M1 1 9 5 1 9" class="d-head" />
        </marker>
      </defs>
      {
        STEPS.map((step, i) => (
          <g>
            <rect x={x(i)} y="16" width={W} height="124" rx="12" class:list={['d-box', { 'd-box--accent': i === 3 }]} />
            <text x={x(i) + 18} y="44" class="d-mono">{step.n}</text>
            <text x={x(i) + 18} y="76" class="d-title">{step.title}</text>
            {step.lines.map((line, j) => (
              <text x={x(i) + 18} y={102 + j * 19} class="d-text">{line}</text>
            ))}
            {i < STEPS.length - 1 && (
              <path d={`M${x(i) + W + 5} 78 H${x(i + 1) - 6}`} class="d-line" marker-end="url(#pipe-arrow)" />
            )}
          </g>
        ))
      }
      {/* the loop: from "prove" back to "port" */}
      <path d={`M${x(3) + W / 2} 146 V186 H${x(2) + W / 2} V147`} class="d-line d-line--accent" marker-end="url(#pipe-arrow)" />
      <text x={(x(2) + x(3) + W) / 2} y="212" text-anchor="middle" class="d-mono">a bit differs: fix the port, run it again</text>
    </svg>
  </div>
  <figcaption class="muted">Each system that is ported goes through the same four steps.</figcaption>
</figure>

<style is:global>
  /* shared by both diagrams on /how-it-works */
  .diagram {
    margin: 0;
    display: grid;
    gap: 10px;
  }

  .diagram__scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 12px;
  }

  .diagram__scroll:focus-visible {
    outline-offset: -2px;
    border-radius: var(--radius);
  }

  /* below this width the picture scrolls sideways inside its box, so the text stays readable */
  .diagram svg {
    width: 100%;
    min-width: 700px;
    height: auto;
  }

  .diagram figcaption {
    font-size: 0.9375rem;
    max-width: 44rem;
  }

  .d-box {
    fill: var(--bg);
    stroke: var(--line);
    stroke-width: 1.5;
  }

  .d-box--accent {
    stroke: var(--accent);
  }

  .d-line {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
  }

  .d-line--accent {
    stroke: var(--accent);
    stroke-dasharray: 5 5;
  }

  .d-head {
    fill: none;
    stroke: context-stroke;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .d-title {
    fill: var(--text);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 21px;
  }

  .d-text {
    fill: var(--muted);
    font-family: var(--font-body);
    font-size: 14.5px;
  }

  .d-strong {
    fill: var(--text);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15.5px;
  }

  .d-mono {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
</style>
